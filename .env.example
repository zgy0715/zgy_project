# ========================
# ⚠️ 安全警告 ⚠️
# ========================
# 请勿将包含真实密钥的 .env 文件提交到版本控制系统！
# 复制此文件为 .env 并填入你的实际值。
# JWT_SECRET 和 INTERNAL_API_KEY 必须满足安全长度要求。
#
# 生成安全密钥:
#   openssl rand -hex 32   (生成64字符的十六进制字符串)
#
# 变量名前缀说明 (由各服务的配置文件决定, 写错会被静默忽略):
#   api-gateway   -> Spring Boot, 读取 application{,-dev,-prod}.yml 中的 ${...}
#   agent-runtime -> app/config.py, 子配置分别使用 DB_ / REDIS_ / LLM_ / SECURITY_ 前缀
#   frontend      -> NEXT_PUBLIC_* (构建期内联, 见 docker-compose.yml 的 build.args)

# ========================
# LLM Configuration
# ========================
LLM_PROVIDER=openai
LLM_OPENAI_API_KEY=sk-your-api-key-here
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_MODEL=gpt-4o
LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_OLLAMA_MODEL=llama3
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# 别名: OPENAI_API_KEY 也支持 (docker-compose 使用)
OPENAI_API_KEY=sk-your-api-key-here

# ========================
# PostgreSQL
# ========================
POSTGRES_DB=deepagent
POSTGRES_USER=deepagent
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# agent-runtime 读取的是 DB_ 前缀 (app/config.py DatabaseConfig)。
# 本地直连 agent-runtime 时必须使用 DB_URL，而不是 DATABASE_URL。
DB_URL=postgresql://deepagent:change-this-password@localhost:5432/deepagent
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ========================
# Redis
# ========================
REDIS_HOST=localhost
REDIS_PORT=6379
# 留空表示不启用 AUTH
REDIS_PASSWORD=
# agent-runtime 读取的是 REDIS_ 前缀
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ========================
# RabbitMQ
# ========================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=deepagent
RABBITMQ_PASSWORD=change-this-password

# ========================
# 🔴 JWT 密钥 (必须修改)
# ========================
# 必须至少32个字符。建议使用 openssl rand -hex 32 生成64字符的密钥
JWT_SECRET=replace-with-at-least-32-char-random-string-here!!

# ========================
# 🔴 内部 API 密钥 (必须设置)
# ========================
# API Gateway 和 Agent Runtime 之间的共享密钥
# 用于保护 Agent Runtime 不被直接访问
# 使用 openssl rand -hex 32 生成
INTERNAL_API_KEY=replace-with-64-char-random-hex-string

# ========================
# JWT 过期时间
# ========================
JWT_ACCESS_TOKEN_EXPIRATION=3600000      # Access Token: 1小时 (毫秒)
JWT_REFRESH_TOKEN_EXPIRATION=604800000   # Refresh Token: 7天 (毫秒)

# ========================
# Agent Runtime
# ========================
AGENT_RUNTIME_HOST=localhost
AGENT_RUNTIME_HTTP_PORT=8000
# gRPC 传输目前仍是占位实现 (api-gateway 侧未真正调用)
AGENT_RUNTIME_GRPC_PORT=50051
AGENT_RUNTIME_URL=http://localhost:8000
AGENT_RUNTIME_INTERNAL_API_KEY=replace-with-64-char-random-hex-string

# ---- agent-runtime 安全设置 (SECURITY_ 前缀) ----
# 允许 Agent 访问的目录白名单 (JSON 数组)。留空 = 全部拒绝 (fail-closed)。
SECURITY_ALLOWED_DIRECTORIES=["/workspace"]
# Agent 是否可以执行 shell 命令。默认 false。
SECURITY_ALLOW_SHELL=false
SECURITY_MAX_FILE_SIZE_MB=10
# 与 INTERNAL_API_KEY 保持一致。留空将导致 agent-runtime 拒绝启动。
SECURITY_INTERNAL_API_KEY=replace-with-64-char-random-hex-string

# ---- agent-runtime 其他设置 ----
# 允许的 CORS 来源 (JSON 数组)。仅当浏览器直连 agent-runtime 时才需要,
# 正常情况下请求都经过 api-gateway。
CORS_ORIGINS=["http://localhost:8080"]
LOG_LEVEL=INFO
DEBUG=false

# ---- 向量引擎 ----
# 向量引擎以内嵌 pybind11 扩展 (vector_engine) 方式运行, 无需 HTTP 地址。
# 仅当单独部署 HTTP 向量服务时才设置 VECTOR_ENGINE_URL。
VECTOR_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_EMBEDDING_DIM=1536
VECTOR_INDEX_TYPE=hnsw

# ========================
# API Gateway
# ========================
API_GATEWAY_PORT=8080
RATE_LIMIT_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ========================
# Frontend
# ========================
# 只有以下两个 NEXT_PUBLIC_* 变量会被前端真正读取
# (frontend/src/lib/api-client.ts:7 和 frontend/src/lib/socket.ts:8)。
# 它们是构建期内联的, 修改后需要重新构建镜像, 运行时设置无效。
# 注意取值格式:
#   - API_URL 必须包含 /api/v1 后缀 (api-client 不会自动拼接)
#   - WS_URL 的协议是 http:// 而不是 ws:// (客户端使用 SockJS)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# ========================
# 对象存储 (当前项目代码未使用, docker-compose 中已停用)
# ========================
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=deepagent
# MINIO_SECRET_KEY=change-this-password
# MINIO_BUCKET=deepagent
